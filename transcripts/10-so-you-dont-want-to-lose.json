   "start": 193.42,
   "end": 195.35999999999999,
   "text": " بعد که"
  },
  {
   "start": 195.35999999999999,
   "end": 197.05999999999997,
   "text": " با توجه به جیبم"
  },
  {
   "start": 197.05999999999997,
   "end": 198.2,
   "text": " میزان سرمایم"
  },
  {
   "start": 198.2,
   "end": 199.29999999999998,
   "text": " میزان ریست پذیرین"
  },
  {
   "start": 199.29999999999998,
   "end": 200.39999999999998,
   "text": " با مسئلت خودم"
  },
  {
   "start": 200.39999999999998,
   "end": 203.17999999999998,
   "text": " این معاقیت رو پذیرفتم"
  },
  {
   "start": 203.17999999999998,
   "end": 205.35999999999999,
   "text": " ورود میکنم به معامله"
  },
  {
   "start": 205.94,
   "end": 207.54,
   "text": " اونجا دیگه تحلیلگر نیستم"
  },
  {
   "start": 207.54,
   "end": 208.85999999999999,
   "text": " اونجا معاملگرم"
  },
  {
   "start": 208.85999999999999,
   "end": 211.57999999999998,
   "text": " کار من در اونجا"
  },
  {
   "start": 211.57999999999998,
   "end": 213.0,
   "text": " در پوزیشن معاملگری"
  },
  {
   "start": 213.0,
   "end": 213.6,
   "text": " اینه که"
  },
  {
   "start": 213.6,
   "end": 215.44,
   "text": " به صورت سفت و سخت"
  },
  {
   "start": 215.44,
   "end": 217.72,
   "text": " متعهد بمونم"
  },
  {
   "start": 217.72,
   "end": 219.57999999999998,
   "text": " به تحلیل قبل از ورود به معاملم"
  },
  {
   "start": 219.58,
   "end": 221.92000000000002,
   "text": " هر اتفاقی که افتاد"
  },
  {
   "start": 221.92000000000002,
   "end": 222.68,
   "text": " فارق از اینکه"
  },
  {
   "start": 222.68,
   "end": 223.60000000000002,
   "text": " به این سمت"
  },
  {
   "start": 223.60000000000002,
   "end": 224.76000000000002,
   "text": " یعنی به تارگتم رفت"
  },
  {
   "start": 224.76000000000002,
   "end": 225.70000000000002,
   "text": " یا به این سمت"
  },
  {
   "start": 225.70000000000002,
   "end": 226.14000000000001,
   "text": " به هر سمت"
  },
  {
   "start": 226.14000000000001,
   "end": 227.14000000000001,
   "text": " تحتی زررم رفت"
  },
  {
   "start": 227.14000000000001,
   "end": 228.26000000000002,
   "text": " تحلیلگر"
  },
  {
   "start": 228.26000000000002,
   "end": 230.12,
   "text": " کار خودش رو درست انجام داده"
  },
  {
   "start": 230.12,
   "end": 231.42000000000002,
   "text": " این منم"
  },
  {
   "start": 231.42000000000002,
   "end": 233.16000000000003,
   "text": " که به عنوان معاملگر"
  },
  {
   "start": 233.16000000000003,
   "end": 234.8,
   "text": " باید متعهد و وفادار"
  },
  {
   "start": 234.8,
   "end": 235.72000000000003,
   "text": " به اون تحلیل باشم"
  },
  {
   "start": 235.72000000000003,
   "end": 238.04000000000002,
   "text": " شما قبل از این که"
  },
  {
   "start": 238.04000000000002,
   "end": 239.98000000000002,
   "text": " وارد معاملهی بشین"
  },
  {
   "start": 239.98000000000002,
   "end": 241.20000000000002,
   "text": " باید"
  },
  {
   "start": 241.20000000000002,
   "end": 242.10000000000002,
   "text": " بپذیرین"
  },
  {
   "start": 242.10000000000002,
   "end": 243.20000000000002,
   "text": " اون حد زرر رو"
  },
  {
   "start": 243.20000000000002,
   "end": 245.06,
   "text": " حد زررت رو خورده بدون"
  },
  {
   "start": 245.06,
   "end": 247.42000000000002,
   "text": " مثلا اگه حد زررت هزار دولاره"
  },
  {
   "start": 247.42000000000002,
   "end": 248.88,
   "text": " فرض کنون هزار دولاره"
  },
  {
   "start": 248.88,
   "end": 250.64000000000001,
   "text": " همون اول معامله ازت میگیرن"
  },
  {
   "start": 250.64000000000001,
   "end": 251.36,
   "text": " ببین"
  },
  {
   "start": 251.36,
   "end": 252.78,
   "text": " میتونی تهمل کنی"
  },
  {
   "start": 252.78,
   "end": 253.12,
   "text": " ببین"
  },
  {
   "start": 253.12,
   "end": 254.76,
   "text": " میتونی حضم کنی"
  },
  {
   "start": 254.76,
   "end": 256.86,
   "text": " ببین بهت آسیمی وارد نمیشه"
  },
  {
   "start": 256.86,
   "end": 258.4,
   "text": " اگر اون هزار دولار رو بدی بره"
  },
  {
   "start": 258.4,
   "end": 260.5,
   "text": " اگر جوابت"
  },
  {
   "start": 260.5,
   "end": 261.82,
   "text": " اینه که"
  },
  {
   "start": 261.82,
   "end": 263.68,
   "text": " نمیتونم واقعا"
  },
  {
   "start": 263.68,
   "end": 265.62,
   "text": " به هیچ وش وارد معامله نشو"
  },
  {
   "start": 265.62,
   "end": 267.98,
   "text": " چون اگر وارد معامله شدی"
  },
  {
   "start": 267.98,
   "end": 269.28,
   "text": " و به حد زررت رسید"
  },
  {
   "start": 269.28,
   "end": 270.22,
   "text": " باید خارج بشی"
  },
  {
   "start": 270.22,
   "end": 270.8,
   "text": " خب"
  },
  {
   "start": 270.8,
   "end": 275.72,
   "text": " پس تو حد زررت رو قبل از به ورود به معامله خورده بدون"
  },
  {
   "start": 275.72,
   "end": 276.88,
   "text": " بذارش کنار"
  },
  {
   "start": 276.88,
   "end": 277.8,
   "text": " اوکی"
  },
  {
   "start": 278.42,
   "end": 279.44,
   "text": " حالا این که"
  },
  {
   "start": 279.44,
   "end": 281.44,
   "text": " حد زرر رو چطور تحییم میکنن"
  },
  {
   "start": 281.44,
   "end": 282.76,
   "text": " چقدر تحییم میکنن"
  },
  {
   "start": 282.76,
   "end": 284.06,
   "text": " اونا بحثش جدستا"
  },
  {
   "start": 284.06,
   "end": 286.14,
   "text": " ما الان اینجا صرفا داریم"
  },
  {
   "start": 286.14,
   "end": 288.48,
   "text": " کسایی که تازه میخوام وارده این بیزنس بشن"
  },
  {
   "start": 288.48,
   "end": 291.62,
   "text": " آشناشو میکنیم با کانسپت زرر"
  },
  {
   "start": 291.62,
   "end": 292.28000000000003,
   "text": " خب"
  },
  {
   "start": 292.28000000000003,
   "end": 294.40000000000003,
   "text": " همه اینا رو گفتم"
  },
  {
   "start": 294.40000000000003,
   "end": 296.56,
   "text": " اما میخوام بگم که"
  },
  {
   "start": 296.56,
   "end": 298.08000000000004,
   "text": " این افراد تازه کار"
  },
  {
   "start": 298.08,
   "end": 300.34,
   "text": " و اون عزیزی که اون اتفاقا براش افتاد"
  },
  {
   "start": 300.34,
   "end": 302.52,
   "text": " زیادا مغصر نیستن"
  },
  {
   "start": 302.52,
   "end": 306.21999999999997,
   "text": " روانشناسا متعالیاتی کردن به این نتیجه رسیدن که"
  },
  {
   "start": 306.21999999999997,
   "end": 309.7,
   "text": " شما باید ده برابر میزان زررت سود کنی"
  },
  {
   "start": 309.7,
   "end": 312.9,
   "text": " تا تازه بلهاز روانی بالانس بشی"
  },
  {
   "start": 312.9,
   "end": 315.29999999999995,
   "text": " یعنی شما اگر هزار دولار زرر کردی"
  },
  {
   "start": 315.29999999999995,
   "end": 318.41999999999996,
   "text": " بعدش بلافاصل ده هزار دولار سود کردی"
  },
  {
   "start": 318.41999999999996,
   "end": 321.86,
   "text": " شما بلهاز روانی نه خوشحالی نه غمگیری"
  },
  {
   "start": 321.86,
   "end": 326.22,
   "text": " اگر اون ده هزار دولار به اضافه یک سنت شد"
  },
  {
   "start": 326.22,
   "end": 329.12,
   "text": " شما تازه سر کیف میایی عزیز"
  },
  {
   "start": 329.12,
   "end": 332.02000000000004,
   "text": " خب پس این یکی از معایب این بیزنسکی"
  },
  {
   "start": 332.02000000000004,
   "end": 333.86,
   "text": " یکی از معایب این شغله"
  },
  {
   "start": 333.86,
   "end": 336.52000000000004,
   "text": " که مدام روح و روان شما مورد"
  },
  {
   "start": 336.52000000000004,
   "end": 338.88,
   "text": " حجوم مارکت قرار میگیره"
  },
  {
   "start": 338.88,
   "end": 341.52000000000004,
   "text": " و شما باید بلد باشین"
  },
  {
   "start": 341.52000000000004,
   "end": 343.72,
   "text": " چطور خودتون رو کنترول کنید"
  },
  {
   "start": 343.72,
   "end": 346.54,
   "text": " خب پس الان راهکار چیه؟"
  },
  {
   "start": 346.54,
   "end": 348.02000000000004,
   "text": " ما نیمدیم اینجا که مثلا"
  },
  {
   "start": 348.02,
   "end": 350.21999999999997,
   "text": " یه دیوونه افسرده"
  },
  {
   "start": 350.21999999999997,
   "end": 352.06,
   "text": " یه روانی پول دار بشیم که"
  },
  {
   "start": 352.06,
   "end": 354.02,
   "text": " خب راهکار چیه برای این موزل؟"
  },
  {
   "start": 354.91999999999996,
   "end": 356.12,
   "text": " ببینید دوتا راهکار"
  },
  {
   "start": 356.12,
   "end": 357.96,
   "text": " در این ویدیو بهتون میدم"
  },
  {
   "start": 357.96,
   "end": 360.18,
   "text": " که نه تنها توی"
  },
  {
   "start": 360.18,
   "end": 362.2,
   "text": " این مسئله در بقیه"
  },
  {
   "start": 362.2,
   "end": 363.94,
   "text": " موزلات زندگی توتون هم"
  },
  {
   "start": 363.94,
   "end": 365.08,
   "text": " به دردتون خواهد خود"
  },
  {
   "start": 365.08,
   "end": 368.32,
   "text": " اون دوتا راهکار چیه هن؟"
  },
  {
   "start": 368.32,
   "end": 370.02,
   "text": " شناخت و پذیرش"
  },
  {
   "start": 370.59999999999997,
   "end": 373.88,
   "text": " مکاتب بزرگ"
  },
  {
   "start": 373.88,
   "end": 375.46,
   "text": " روان شناسی در دنیا"
  },
  {
   "start": 375.46,
   "end": 378.0,
   "text": " شناخت رو برابر درمان"
  },
  {
   "start": 378.0,
   "end": 379.92,
   "text": " چرا وقتی میری پیش"
  },
  {
   "start": 379.92,
   "end": 381.78,
   "text": " یه روان کاب با هات"
  },
  {
   "start": 381.78,
   "end": 382.96,
   "text": " صحبت میکنه مثلا"
  },
  {
   "start": 382.96,
   "end": 385.72,
   "text": " از بچه گیت میپرسه از فلان چیز میپرسه"
  },
  {
   "start": 385.72,
   "end": 387.98,
   "text": " چرا چون تو وقتی در این حال"
  },
  {
   "start": 387.98,
   "end": 389.58,
   "text": " که داری برای اون تعریف میکنی"
  },
  {
   "start": 389.58,
   "end": 392.1,
   "text": " خودت داری خودت رو بیشتر میشناسی"
  },
  {
   "start": 392.1,
   "end": 393.88,
   "text": " و شناخت"
  },
  {
   "start": 393.88,
   "end": 396.64,
   "text": " از نظر اون فرد برابر درمان است"
  },
  {
   "start": 396.64,
   "end": 397.94,
   "text": " نکته بعد این که"
  },
  {
   "start": 397.94,
   "end": 399.08,
   "text": " بپذیریش"
  },
  {
   "start": 399.08,
   "end": 401.7,
   "text": " وقتی زرر کردی نخواه"
  },
  {
   "start": 401.7,
   "end": 403.7,
   "text": " از بازار انتقام بگیری"
  },
  {
   "start": 403.7,
   "end": 406.36,
   "text": " نگو میرم بازار رو میتره کنم"
  },
  {
   "start": 406.36,
   "end": 408.16,
   "text": " نگو علم میکنم"
  },
  {
   "start": 408.16,
   "end": 409.12,
   "text": " بل میکنم"
  },
  {
   "start": 409.12,
   "end": 411.72,
   "text": " از بازار فاصله بگیر"
  },
  {
   "start": 411.72,
   "end": 413.82,
   "text": " بعد فرداش"
  },
  {
   "start": 413.82,
   "end": 415.96000000000004,
   "text": " یا هر موقعی که نشستی دوباره پشت سیستم"
  },
  {
   "start": 415.96000000000004,
   "end": 417.16,
   "text": " یه روز دیگه است"
  },
  {
   "start": 417.16,
   "end": 419.06,
   "text": " انگار نه انگار اتفاقی افتاده"
  },
  {
   "start": 419.06,
   "end": 422.44,
   "text": " پس اگر بخواهم یه جمع بندی بکنم"
  },
  {
   "start": 422.44,
   "end": 423.16,
   "text": " تو"
  },
  {
   "start": 423.16,
   "end": 425.42,
   "text": " به عنوانه یه تریدر تازه کار"
  },
  {
   "start": 425.42,
   "end": 427.72,
   "text": " یه کسی که این بیزنس رو انتخاب کردی"
  },
  {
   "start": 427.72,
   "end": 430.36,
   "text": " حتماً زرر میکنی"
  },
  {
   "start": 430.36,
   "end": 431.48,
   "text": " و این"
  },
  {
   "start": 431.48,
   "end": 434.22,
   "text": " نه یه فخشه نه یه نفرینه"
  },
  {
   "start": 434.22,
   "end": 438.02000000000004,
   "text": " این واقعیت محض این بیزنسه"
  },
  {
   "start": 438.02000000000004,
   "end": 439.90000000000003,
   "text": " شناختیمش"
  },
  {
   "start": 439.90000000000003,
   "end": 441.76000000000005,
   "text": " امیدوارم که بپذیریش"
  },
  {
   "start": 441.76000000000005,
   "end": 443.74,
   "text": " و یادت نره که"
  },
  {
   "start": 443.74,
   "end": 445.72,
   "text": " جدیش نگیرم و جدیوازی کنم"
  },
  {
   "start": 445.72,
   "end": 446.44000000000005,
   "text": " خداحافظ"
  }
 ]
}
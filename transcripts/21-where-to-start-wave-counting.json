  {
   "start": 295.64,
   "end": 297.21999999999997,
   "text": " از اونجاهایی که مشخص شد"
  },
  {
   "start": 297.21999999999997,
   "end": 299.0,
   "text": " خودتون شروع کنید به تحلیل کردن و"
  },
  {
   "start": 299.0,
   "end": 300.09999999999997,
   "text": " موجه شماری"
  },
  {
   "start": 300.09999999999997,
   "end": 301.24,
   "text": " اگر سؤالی هم داشت"
  },
  {
   "start": 301.24,
   "end": 302.14,
   "text": " یعنیت من تو کامنت ها برام"
  },
  {
   "start": 302.14,
   "end": 303.46,
   "text": " بنویسید"
  },
  {
   "start": 303.46,
   "end": 305.06,
   "text": " و نکته بعدی این که"
  },
  {
   "start": 305.06,
   "end": 306.02,
   "text": " الگوریتم های یوتوب"
  },
  {
   "start": 306.02,
   "end": 307.14,
   "text": " اینطور کار میکنه که"
  },
  {
   "start": 307.14,
   "end": 309.0,
   "text": " هر چقدر لایک ویدیو بیشتر باشه"
  },
  {
   "start": 309.0,
   "end": 310.97999999999996,
   "text": " کامنت ویدیو بیشتر باشه"
  },
  {
   "start": 310.97999999999996,
   "end": 312.36,
   "text": " این الگوریتم"
  },
  {
   "start": 312.36,
   "end": 314.36,
   "text": " این ویدیو رو بیشتر به افراد مختلف"
  },
  {
   "start": 314.36,
   "end": 315.76,
   "text": " پیشنادش میکنه"
  },
  {
   "start": 315.76,
   "end": 318.2,
   "text": " پس کچکترین هماریتی که میتونید بکنید"
  },
  {
   "start": 318.2,
   "end": 320.02000000000004,
   "text": " این ویدیوها رو حتما لایک کنید"
  },
  {
   "start": 320.02000000000004,
   "end": 321.38,
   "text": " کامنت بگذارین"
  },
  {
   "start": 321.38,
   "end": 322.98,
   "text": " سؤالی دارین حتما بپرسید"
  },
  {
   "start": 322.98,
   "end": 324.56,
   "text": " اینطوری کمک هم میشه که"
  },
  {
   "start": 324.56,
   "end": 326.22,
   "text": " این ویدیو به دست بقیه هم"
  },
  {
   "start": 326.22,
   "end": 327.52000000000004,
   "text": " برسه"
  },
  {
   "start": 327.52000000000004,
   "end": 329.5,
   "text": " مرسی که تمید دست ویدیو با من همراه بودی"

  {
   "start": 238.57999999999998,
   "end": 239.57999999999998,
   "text": " بریم که با هم"
  },
  {
   "start": 239.57999999999998,
   "end": 242.57999999999998,
   "text": " ویدیو رو شروع کنیم"
  },
  {
   "start": 242.57999999999998,
   "end": 243.29999999999998,
   "text": " یک"
  },
  {
   "start": 243.29999999999998,
   "end": 244.23999999999998,
   "text": " دو"
  },
  {
   "start": 244.23999999999998,
   "end": 244.72,
   "text": " سه"
  },
  {
   "start": 244.72,
   "end": 246.7,
   "text": " در طول ویدیو گفتم"
  },
  {
   "start": 246.7,
   "end": 248.2,
   "text": " بازم تحکید می کنم"
  },
  {
   "start": 248.2,
   "end": 249.23999999999998,
   "text": " که در"
  },
  {
   "start": 249.23999999999998,
   "end": 251.23999999999998,
   "text": " یک"
  },
  {
   "start": 251.23999999999998,
   "end": 251.92,
   "text": " دو"
  },
  {
   "start": 251.92,
   "end": 252.28,
   "text": " سه"
  },
  {
   "start": 252.28,
   "end": 253.54,
   "text": " توجه خیلی"
  },
  {
   "start": 253.54,
   "end": 254.14,
   "text": " یک"
  },
  {
   "start": 254.14,
   "end": 254.92,
   "text": " دو"
  },
  {
   "start": 254.92,
   "end": 255.29999999999998,
   "text": " سه"
  },
  {
   "start": 255.29999999999998,
   "end": 256.86,
   "text": " در طول ویدیو بهش گفتم"
  },
  {
   "start": 256.86,
   "end": 257.36,
   "text": " یک"
  },
  {
   "start": 257.36,
   "end": 258.2,
   "text": " دو"
  },
  {
   "start": 258.2,
   "end": 258.76,
   "text": " سه"
  },
  {
   "start": 258.76,
   "end": 260.18,
   "text": " در طول ویدیو گفتم"
  },
  {
   "start": 260.18,
   "end": 261.58,
   "text": " بازم تحکید می کنم"
  },
  {
   "start": 261.58,
   "end": 263.18,
   "text": " که در این ویدیو"
  },
  {
   "start": 263.18,
   "end": 264.34,
   "text": " هدف من"
  },
  {
   "start": 264.34,
   "end": 266.26,
   "text": " تحلیل چارت هایی که دیدیم"

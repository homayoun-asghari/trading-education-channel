  {
   "start": 270.12,
   "end": 272.47999999999996,
   "text": " اون دیده الیوتوی که شما لازم دارین"
  },
  {
   "start": 272.47999999999996,
   "end": 273.58,
   "text": " رو بهتون بدم"
  },
  {
   "start": 273.58,
   "end": 274.03999999999996,
   "text": " اون"
  },
  {
   "start": 274.03999999999996,
   "end": 276.56,
   "text": " سؤال که از کجا شروع کنید"
  },
  {
   "start": 276.56,
   "end": 277.21999999999997,
   "text": " به موض شما"
  },
  {
   "start": 277.21999999999997,
   "end": 278.97999999999996,
   "text": " رو جوابش رو به شما بدم"
  },
  {
   "start": 278.97999999999996,
   "end": 281.62,
   "text": " و اگر در طول ویدیو سناریوی"
  },
  {
   "start": 281.62,
   "end": 282.29999999999995,
   "text": " مطرح شد"
  },
  {
   "start": 282.29999999999995,
   "end": 283.47999999999996,
   "text": " یا موقعیت بایوسلی"
  },
  {
   "start": 283.47999999999996,
   "end": 284.62,
   "text": " مطرح شد"
